# Signs the demo session cookie. Change this anywhere that isn't your laptop.
SESSION_SECRET=change-me
# Where the SQLite database lives.
DATABASE_PATH=data/swipestakes.db
# "open-meteo" (real New Haven weather) or "mock" (offline, deterministic, for development only).
WEATHER_PROVIDER=open-meteo
# House margin on parlay odds, 0 = fair odds. 0.05 = 5%.
PARLAY_MARGIN=0
